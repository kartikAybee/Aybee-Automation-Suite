# ============================================================
# secrets.properties.example — committed to version control
# Copy this file to secrets.properties and fill in your values.
# secrets.properties is gitignored and must never be committed.
# ============================================================

# ChromeDriver — absolute path on this machine
CHROME_DRIVER_PATH=

# Mailosaur — email interception for OTP verification
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=

# Google test account — used for Google OAuth automation
GOOGLE_TEST_EMAIL=
GOOGLE_TEST_PASSWORD=

# Chrome profile path — Chrome profile where GOOGLE_TEST_EMAIL is already signed in
# Leave blank to use a fresh profile
CHROME_PROFILE_PATH=
