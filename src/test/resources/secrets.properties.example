# ============================================================
# secrets.properties.example — committed to version control
# Copy this file to secrets.properties and fill in your values.
# secrets.properties is gitignored and must never be committed.
# ============================================================

# ChromeDriver — absolute path on this machine
CHROME_DRIVER_PATH=

# Existing user credentials (used when USE_NEW_USER=false)
VALID_EMAIL=
VALID_PASSWORD=

# Mailosaur — required when USE_NEW_USER=true
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=

# Asset image — absolute path on this machine
ASSET_IMAGE_PATH=
